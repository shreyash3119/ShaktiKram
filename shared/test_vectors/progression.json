{
  "function": "calc_progression",
  "cases": [
    {
      "name": "all sets at the top of the range: small increase",
      "input": {
        "rep_min": 8,
        "rep_max": 12,
        "target_sets": 3,
        "increment_kg": 2.5,
        "sets": [
          {
            "weight_kg": 60,
            "reps": 12,
            "rir": 2
          },
          {
            "weight_kg": 60,
            "reps": 12,
            "rir": 2
          },
          {
            "weight_kg": 60,
            "reps": 12,
            "rir": 2
          }
        ]
      },
      "expect": {
        "action": "increase",
        "suggested_weight_kg": 62.5,
        "target_reps": 8,
        "reason_codes": [
          "top_of_range_all_sets"
        ]
      }
    },
    {
      "name": "zero reps in reserve on a set: repeat",
      "input": {
        "rep_min": 8,
        "rep_max": 12,
        "target_sets": 3,
        "increment_kg": 2.5,
        "sets": [
          {
            "weight_kg": 60,
            "reps": 12,
            "rir": 2
          },
          {
            "weight_kg": 60,
            "reps": 12,
            "rir": 1
          },
          {
            "weight_kg": 60,
            "reps": 12,
            "rir": 0
          }
        ]
      },
      "expect": {
        "action": "repeat",
        "suggested_weight_kg": 60,
        "target_reps": 12,
        "reason_codes": [
          "effort_very_high"
        ]
      }
    },
    {
      "name": "inside the range: add a rep",
      "input": {
        "rep_min": 8,
        "rep_max": 12,
        "target_sets": 3,
        "increment_kg": 2.5,
