# Copy to .env and fill in. Never commit .env. Placeholders only.
APP_ENV=development
DEBUG=false

# The READ-ONLY reporting role (pfs_reader), never the owner or service-role connection.
# Set its password once with: alter role pfs_reader login password '...';
DATABASE_URL=postgresql+psycopg://pfs_reader:CHANGE_ME@127.0.0.1:5432/postgres

# Used to ask Supabase Auth whether the app's access token is valid, and to download media files with the owner's own session.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Folder that holds shared/vocabulary. Leave empty to use the repository's own shared folder.
SHARED_DIR=
